{
  "name": "@ryancormack/strands-acp",
  "version": "0.1.0",
  "description": "ACP bridge for Strands agents - expose any Strands agent via the Agent Client Protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryancormack/strands-acp.git"
  },
  "homepage": "https://github.com/ryancormack/strands-acp#readme",
